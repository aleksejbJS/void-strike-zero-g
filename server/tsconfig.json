{
    "compilerOptions": {
        "target": "es2020",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "rootDir": "..",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["../src/*"]
        }
    },
    "include": [
        "src/**/*",
        "../src/**/*"
    ],
    "exclude": [
        "node_modules",
        "../node_modules"
    ]
}
